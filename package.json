{
  "name": "dsh-sidebar-browser-agent",
  "version": "0.2.10",
  "type": "module",
  "icon": "./icon.svg",
  "description": "Native agent control for the DSH right-sidebar browser: manage tabs, and read, click, type, scroll, run JavaScript in and screenshot the real page through its Electron guest.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hesitate-P/dsh-sidebar-browser-agent.git"
  },
  "homepage": "https://github.com/Hesitate-P/dsh-sidebar-browser-agent#readme",
  "bugs": {
    "url": "https://github.com/Hesitate-P/dsh-sidebar-browser-agent/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-browser",
    "electron-webview"
  ],
  "exports": {
    ".": "./lib/entry-0.2.10.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/**",
    "test/**",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "pack:check": "npm pack --dry-run",
    "version:set": "node scripts/set-version.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
